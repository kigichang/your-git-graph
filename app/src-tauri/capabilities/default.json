{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Graph windows (the configured one and those File > New Window / Open opens): every command of the app, core IPC, the folder and save pickers, message boxes, setting their title",
  "windows": ["main", "repo-*"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-close",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "allow-initial-repo",
    "allow-repo-read",
    "allow-repo-op",
    "allow-repo-op-cancel",
    "allow-trust-filters",
    "allow-engine-request",
    "allow-host-log",
    "allow-self-test",
    "allow-selftest-write",
    "allow-preview",
    "allow-preview-resize",
    "allow-export-repo-config",
    "allow-clipboard-write",
    "allow-open-url",
    "allow-open-repo-file",
    "allow-reveal-repo",
    "allow-open-terminal",
    "allow-mount-volume",
    "allow-network-volume",
    "allow-askpass-reply",
    "allow-remote-connect",
    "allow-remote-disconnect",
    "allow-open-diff-window",
    "allow-worktree-file",
    "allow-render-plantuml",
    "allow-fetch-image",
    "allow-scan-repos",
    "allow-recent-repos",
    "allow-repo-opened",
    "allow-open-new-window",
    "allow-set-appearance",
    "allow-state-snapshot",
    "allow-state-set",
    "allow-settings-get",
    "allow-settings-set",
    "allow-open-settings-file",
    "allow-open-session-log"
  ]
}
