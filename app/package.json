    "@tsconfig/svelte": "5.0.8",
    "@types/node": "24.19.2",
    "@vscode/markdown-it-katex": "1.1.2",
    "esbuild": "0.28.2",
    "jsdom": "31.0.0",
    "katex": "0.19.1",
    "markdown-it": "15.0.3",
    "markdown-it-task-lists": "2.1.1",
    "mermaid": "12.2.0",
    "monaco-editor": "0.57.0",
    "svelte": "5.57.3",
